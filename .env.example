# Application
APP_URL=http://localhost:3000
NODE_ENV=development

# Session signing (generate with: openssl rand -base64 48)
AUTH_SECRET=change-me-to-a-long-random-string

# AES-256-GCM key for workspace secrets (64 hex chars). Falls back to AUTH_SECRET if unset.
# openssl rand -hex 32
ENCRYPTION_KEY=

# SQLite file used by default. Postgres is supported via DATABASE_URL.
DATABASE_URL=file:./data/workflow-os.db

# SpaceXAI / xAI — never expose this to the browser
# https://console.x.ai
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
XAI_MODEL=grok-4.6

# Optional additional providers (architecture is ready; leave empty to hide from picker)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Dev convenience
SEED_ON_BOOT=true
WORKER_POLL_MS=750
